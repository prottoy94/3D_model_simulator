# Copy this file to .env.local and fill in the keys you have.
# .env.local is git-ignored. This example file is committed and must never hold real keys.
# Any one key is enough; providers without a key are hidden in the app.

# Which provider the app uses first: gemini | groq | qwen | openrouter | anthropic
AI_PROVIDER=gemini

GOOGLE_API_KEY=""
GROQ_API_KEY=""
OPENROUTER_API_KEY=""

# Qwen (Alibaba Model Studio, OpenAI-compatible endpoint)
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1"

# Optional
ANTHROPIC_API_KEY=""
